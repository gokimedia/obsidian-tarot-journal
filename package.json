{
  "name": "obsidian-tarot-journal",
  "version": "1.0.2",
  "description": "Offline 78-card tarot journal for daily notes and upright or reversed readings in Obsidian.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "lint": "eslint .",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "keywords": [
    "obsidian",
    "tarot",
    "journal",
    "divination",
    "deckaura"
  ],
  "author": "Deckaura <hello@deckaura.com> (https://deckaura.com)",
  "license": "MIT",
  "homepage": "https://deckaura.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/gokimedia/obsidian-tarot-journal.git"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.10.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.9.1",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "globals": "^17.11.0",
    "jiti": "^2.7.0",
    "obsidian": "latest",
    "tslib": "^2.8.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.68.0"
  }
}
